# ESP32-S3 Super Mini specific ESP-IDF configuration overrides
# This file contains only the changes needed for the Super Mini board
# Inherits base configuration from ../esp32s3/esp-idf/sdkconfig.defaults

# Flash size: 4MB (Super Mini has 4MB, not 8MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table: Use Super Mini specific partition table
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../targets/esp32s3supermini/partitions.csv"

# MAC addresses: Use single MAC to prevent 28-second boot delay
CONFIG_ESP32S3_UNIVERSAL_MAC_ADDRESSES_ONE=y

# Bootloader: Enable debug logging for troubleshooting
CONFIG_BOOTLOADER_LOG_LEVEL_DEBUG=y

# Native USB:
# ArduPilot drives the chip's USB Serial/JTAG controller directly (see
# AP_HAL_ESP32::USBCDC) for SERIAL0 / MAVLink. The IDF console is disabled
# so its log text does not corrupt binary MAVLink frames sharing the same
# USB endpoint.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Stack sizes: Increase to prevent stack overflows
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# Logging: Reduce default level to prevent stack issues
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
