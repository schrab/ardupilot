# ESP32-S3 Super Mini - ArduCopter defaults for 2S PWM quad
FRAME_CLASS 1       # Quad
FRAME_TYPE 1        # X frame

# PWM ESC output (standard 50Hz PWM)
MOT_PWM_TYPE 0      # Normal PWM
RC_SPEED 400        # 400Hz PWM rate

# Scheduler
SCHED_LOOP_RATE 100

# SERIAL0: USB Console / MAVLink
SERIAL0_PROTOCOL 2
SERIAL0_BAUD 115

# SERIAL1: MAVLink over WiFi UDP (port 14550)
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 115

# SERIAL2: ELRS Receiver (CRSF)
SERIAL2_PROTOCOL 23
SERIAL2_BAUD 115

# SERIAL3: GPS on UART1 hardware (GPIO16 RX / GPIO15 TX)
SERIAL3_PROTOCOL 5
SERIAL3_BAUD 115
GPS_TYPE 5
GPS_AUTO_CONFIG 1
GPS_GNSS_MODE 0
GPS_RATE_MS 100
GPS_SAVE_CFG 1

# Logging & SD Card
LOG_BACKEND_TYPE 1
LOG_DISARMED 1

# Battery monitoring (GPIO1)
BATT_MONITOR 3
BATT_VOLT_PIN 1
BATT_VOLT_MULT 9.9
BATT_ARM_VOLT 6.8
BATT_LOW_VOLT 6.6
BATT_CRT_VOLT 6.2

# Arming checks
ARMING_CHECK 48640

# RC input
RC_PROTOCOLS 0
